<!DOCTYPE html>
<html lang="es">

<head>
    <!-- Capa de red robusta: DEBE cargar primero y de forma síncrona (sin defer,
         sin type="module") para envolver window.fetch ANTES de que cualquier
         módulo del flujo lo use. Aporta timeout + reintentos + aviso
         "Reconectando…" + keep-alive frente a los cold starts de Render/Railway
         en capa gratuita. -->
    <script src="/js/fetchRobusto.js"></script>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, minimum-scale=1.0, user-scalable=no, viewport-fit=cover">
    <title>Dashboard</title>
    <style>
        #app-loader {
            position: fixed;
            inset: 0;
            z-index: 10000;
            display: grid;
            place-items: center;
            background: #fff;
        }

        #app-loader img {
            display: block;
            width: 88px;
            height: 90px;
        }
    </style>
    <!-- Preconnect + fuente de iconos AL INICIO. display=block: mientras la
         fuente carga, el navegador dibuja los iconos invisibles (nunca las
         palabras "school", "person"…); el loader los tapa igual. -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=Material+Symbols+Rounded:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200&display=block" />
    <link rel="stylesheet" href="/css/rubrica-editar.css">
    <link rel="stylesheet" href="/css/default-rules.css">
    <script type="module" src="/js/menu.js" defer></script>
    <link rel="stylesheet" href="/css/main.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/driver.js@1.4.0/dist/driver.css">
    <link rel="stylesheet" href="/css/guia.css">
    <link rel="stylesheet" href="/css/app-loader.css">
    <link rel="stylesheet" href="/css/menu.css">
    <link rel="stylesheet" href="/css/proyectos.css">
    <link rel="stylesheet" href="/css/inicio.css">
    <link rel="stylesheet" href="/css/evaluacion-detalle.css">
    <link rel="stylesheet" href="/css/proyecto-editar.css">
    <link rel="stylesheet" href="/css/custom-select.css">
    <script src="/js/custom-select.js" defer></script>
    <link rel="manifest" href="manifest.webmanifest">
    <script type="module" src="/js/notificaciones.js"></script>
    <link rel="stylesheet" href="/css/notificaciones.css">
    <link rel="stylesheet" href="/css/circular-progress.css">
    <link rel="stylesheet" href="/css/dialog.css">
    <link rel="stylesheet" href="/css/configuracion.css">
    <link rel="stylesheet" href="/css/ripple.css">
    <link rel="stylesheet" href="/css/input-fields.css">
    <link rel="icon" href="/assets/svg/Logo_SV.svg" type="image/svg+xml">
    <script src="https://cdn.jsdelivr.net/npm/driver.js@1.4.0/dist/driver.js.iife.js" defer></script>
    <script type="module" src="/js/proyectos.js" defer></script>
    <script type="module" src="/js/inicio.js" defer></script>
    <script type="module" src="/js/criterios-rubrica.js" defer></script>
    <script type="module" src="/js/proyectos-evaluados.js" defer></script>
    <script type="module" src="/js/exportar-grado.js" defer></script>
    <script type="module" src="/js/editar-criterios.js" defer></script>
    <script type="module" src="/js/evaluacion-detalle.js" defer></script>
    <script type="module" src="/js/proyecto-editar.js" defer></script>
    <script type="module" src="/js/router.js"></script>
    <script type="module" src="/js/searchList.js" defer></script>
    <script type="module" src="/js/ripple.js" defer></script>
    <script type="module" src="/js/configuracion.js" defer></script>
    <script type="module">
        import 'https://esm.run/@material/web/all.js'
    </script>
    <script src="/js/native-app.js" defer></script>
</head>

<body data-permisos="<%= JSON.stringify(locals.permisos || {}) %>">
    <div id="app-loader" class="app-loader is-active" role="status" aria-label="Cargando">
        <img src="/assets/svg/Logo_SV_loader.svg" alt="" class="app-loader__logo">
    </div>
    <script>
        // ── Loader crítico ────────────────────────────────────────────────
        // Se ejecuta de forma síncrona justo después del #app-loader, antes de
        // cualquier otro recurso. Decisión de diseño: NO usamos window.load
        // porque espera también a CDNs de terceros que el dashboard ni necesita
        // (driver.js, @material/web de esm.run); si uno cuelga, el loader se
        // quedaba pegado (el "a veces falla" original).
        //
        // En su lugar, ocultamos el loader cuando la app esté lista para verse
        // bien, es decir, cuando se cumplan las tres condiciones:
        //   1. La vista inicial ya se inyectó en el DOM (lo avisa router.js).
        //   2. La fuente de iconos (Material Symbols) está cargada → sin FOUC.
        //   3. Los datos de la sección ya cargaron (sus loaders .section-loader
        //      / .inicio-recientes__loader / .criterios-loader desaparecieron),
        //      para no revelar barras de carga a medio llenar bajo el loader.
        // Fallbacks para que NUNCA quede colgado:
        //   - Si el fetch falla, router.js marca la condición 1 y pinta la UI
        //     de error (se oculta el loader, nunca pantalla blanca).
        //   - Deadlines en la espera del probe de fuente (8 s) y de datos (8 s);
        //     el deadline de fuente NO marca fontsReady si el glifo no se
        //     pintó. Última garantía a los 28 s por si algo se cuelga del todo.
        (function () {
            var loader = document.getElementById('app-loader');
            var FONT_FACE = '700 24px "Material Symbols Rounded"';
            var viewReady = false;
            var fontsReady = false;
            var fontWaitStarted = false;
            var done = false;
            var fallbackTimer = null;

            var ICON_PROBE_WORD = 'settings';
            var ICON_GLYPH_MAX_PX = 48;

            function iconProbe() {
                var probe = document.getElementById('app-loader-icon-probe');
                if (probe) return probe;
                probe = document.createElement('span');
                probe.id = 'app-loader-icon-probe';
                probe.setAttribute('aria-hidden', 'true');
                probe.textContent = ICON_PROBE_WORD;
                probe.style.cssText = [
                    'position:absolute',
                    'left:0',
                    'top:0',
                    'visibility:hidden',
                    'pointer-events:none',
                    'font-family:"Material Symbols Rounded"',
                    'font-weight:700',
                    'font-style:normal',
                    'font-size:24px',
                    'line-height:1',
                    'letter-spacing:normal',
                    'white-space:nowrap',
                    'font-feature-settings:"liga"',
                    '-webkit-font-feature-settings:"liga"',
                    'font-variation-settings:"FILL" 0, "wght" 700, "GRAD" 0, "opsz" 48'
                ].join(';');
                document.body.appendChild(probe);
                return probe;
            }

            function iconsArePainted() {
                if (!document.body) return false;
                var width = iconProbe().getBoundingClientRect().width;
                return width > 0 && width <= ICON_GLYPH_MAX_PX;
            }

            function markIconsReady() {
                var probe = document.getElementById('app-loader-icon-probe');
                if (probe) probe.remove();
                document.documentElement.classList.add('icons-ready');
            }

            // ¿Sigue la fuente de iconos descargándose (petición "pending")?
            // Mientras sea true NUNCA se oculta el loader, tarde lo que tarde.
            function iconFontPending() {
                var link = document.querySelector(
                    'link[href*="fonts.googleapis.com/css2"][href*="Material"]'
                );
                if (link && !link.sheet && document.readyState !== 'complete') return true;
                var fonts = document.fonts;
                if (!fonts || typeof fonts.forEach !== 'function') return false;
                var pending = false;
                fonts.forEach(function (face) {
                    if (!/Material Symbols/i.test(face.family)) return;
                    if (face.status === 'loading') pending = true;
                    else if (face.status === 'unloaded' && document.readyState !== 'complete') pending = true;
                });
                return pending;
            }

            // Espera el glifo pintado SIN deadline por tiempo. Solo si la fuente
            // FALLÓ de forma definitiva (ni pintada ni pendiente durante
            // FONT_FAILED_GRACE_MS) deja de esperar, para no congelar la app.
            var FONT_FAILED_GRACE_MS = 2500;
            function waitUntilIconsPainted() {
                return new Promise(function (resolve) {
                    var settledSince = 0;
                    (function poll() {
                        if (iconsArePainted()) {
                            requestAnimationFrame(function () { resolve(true); });
                            return;
                        }
                        if (iconFontPending()) {
                            settledSince = 0;
                        } else {
                            settledSince = settledSince || Date.now();
                            if (Date.now() - settledSince > FONT_FAILED_GRACE_MS) {
                                resolve(false);
                                return;
                            }
                        }
                        setTimeout(poll, 50);
                    })();
                });
            }

            function finish() {
                if (done) return;
                done = true;
                if (fallbackTimer) { clearTimeout(fallbackTimer); fallbackTimer = null; }
                markIconsReady();
                if (!loader) return;
                loader.classList.remove('is-active');
                var cleanup = function () {
                    loader.removeEventListener('transitionend', cleanup);
                    loader.style.display = 'none';
                };
                loader.addEventListener('transitionend', cleanup);
                // Red de seguridad por si la transición no dispara transitionend.
                setTimeout(cleanup, 400);
            }

            function tryFinish() {
                if (!viewReady || !fontsReady) return;
                // Además de la vista y la fuente, esperamos a que terminen de
                // cargarse los DATOS de la sección: cada parcial trae su propio
                // loader (.section-loader, .inicio-recientes__loader,
                // .criterios-loader) que se oculta cuando hideLoader() recibe la
                // respuesta. Si reveláramos antes, se verían esas barras dando
                // vueltas bajo el loader global ("se veía que seguía cargando").
                waitForDataReady().then(finish);
            }

            // ¿Queda algún loader de sección visible en el contenido principal?
            function hasActiveSectionLoaders() {
                var loaders = document.querySelectorAll(
                    '#main__container .section-loader, ' +
                    '#main__container .inicio-recientes__loader, ' +
                    '#main__container .criterios-loader'
                );
                for (var i = 0; i < loaders.length; i++) {
                    // getClientRects() distingue visible de oculto sin importar
                    // si se ocultó con display:none, visibility, etc.
                    if (loaders[i].getClientRects().length) return true;
                }
                return false;
            }

            // Espera a que los loaders de sección desaparezcan (datos listos),
            // con un deadline para no colgarse si un fetch tarda de más.
            function waitForDataReady() {
                return new Promise(function (resolve) {
                    var deadline = Date.now() + 8000;
                    (function poll() {
                        if (!hasActiveSectionLoaders() || Date.now() > deadline) return resolve();
                        setTimeout(poll, 100);
                    })();
                });
            }

            // Recopila el texto de los iconos actuales para forzar la carga de
            // sus glifos concretos (Material Symbols usa ligaduras y sirve los
            // glifos por subsets por unicode-range).
            function collectIconText() {
                var text = '';
                var spans = document.querySelectorAll('.material-symbols-rounded');
                for (var i = 0; i < spans.length; i++) {
                    var t = (spans[i].textContent || '').trim();
                    if (t) text += t;
                }
                return text || 'school';
            }

            // Aprovechamos `fonts.load`/`fonts.ready` como adelanto, pero el probe
            // es la señal visual autorizatoria. No marcamos fontsReady si el
            // probe no se pintó dentro del deadline, así el loader no se revela
            // mientras el glifo (Material Symbols) aún no está aplicado.
            function waitForIconFonts() {
                if (fontWaitStarted) return;
                fontWaitStarted = true;
                var fonts = document.fonts;
                var text = collectIconText() + ICON_PROBE_WORD;
                // fonts.load() solo adelanta la descarga; la condición es el probe.
                try {
                    if (fonts && fonts.load) {
                        var load = fonts.load(FONT_FACE, text);
                        if (load && typeof load.catch === 'function') {
                            load.catch(function () { /* el probe decide */ });
                        }
                    }
                } catch (e) { /* el probe decide */ }

                waitUntilIconsPainted().then(function () {
                    fontsReady = true;
                    tryFinish();
                });
            }

            // Lo llama router.js cuando la vista inicial está en el DOM (éxito
            // o error). Ahora que el DOM tiene menú + vista, forzamos y
            // esperamos la fuente de los iconos visibles antes de revelar.
            window.__appLoaderViewReady = function () {
                viewReady = true;
                waitForIconFonts();
            };

            // Fallback manual para forzar el ocultado desde otros puntos.
            window.hideAppLoader = finish;

            // Pre-calentamiento: empieza a bajar la fuente base en paralelo,
            // mientras el router hace el fetch de la vista inicial.
            if (document.fonts && document.fonts.load) {
                document.fonts.load(FONT_FACE).catch(function () { /* silencioso */ });
            }

            // Red de seguridad dura: nunca dejar la app bloqueada tras el
            // loader, pero solo revelar el overlay una vez que la vista ya
            // está en el DOM y la fuente de iconos está lista (lo mismo que
            // tryFinish). Si se acaba el tiempo y aún no lo están, seguimos
            // esperando (la pestaña no queda colgada de fondo).
            fallbackTimer = setTimeout(function () {
                if (viewReady && fontsReady) {
                    finish();
                }
            }, 12000);

            // Última garantía (igual que app-loader.js): tras ~28 s libera el
            // overlay, pero NUNCA mientras la fuente de iconos siga pendiente;
            // en ese caso reintenta cada segundo.
            setTimeout(function lastResort() {
                if (!loader || !loader.classList.contains('is-active')) return;
                if (iconFontPending() && !iconsArePainted()) {
                    setTimeout(lastResort, 1000);
                    return;
                }
                finish();
            }, 28000);
        })();
    </script>
    <div id="infoCard" class="info-card menu_contextual">
        <button class="menu-close-btn" onclick="closeAll()" aria-label="Cerrar" data-ripple>
            <span class="material-symbols-rounded">close</span>
        </button>
        <div class="info_user centrar">
            <div class="user_profile img-card">
                <span class="material-symbols-rounded perfil-card-icon" aria-hidden="true">account_circle</span>
            </div>
            <h3 class="title">
                <%= maestro.nombre %>
            </h3>
            <span
                class="perfil-card-rol perfil-card-rol--<%= String(maestro.rolNombre || '').toLowerCase().replace(/\s+/g, '-') %>">
                <%= maestro.rolNombre %>
            </span>
            <div class="btn-accion centrar" onclick="navigateTo('/menu/inicio')" data-ripple>
                <span class="material-symbols-rounded">
                    logout
                </span>
                <p>Ir al Inicio</p>
            </div>
            <div class="btn-accion centrar" data-config-abrir role="button" tabindex="0" data-ripple>
                <span class="material-symbols-rounded">
                    settings
                </span>
                <p>Configuración</p>
            </div>
            <div class="logout-btn centrar" onclick="CerrarSesion()" data-ripple>
                <span class="material-symbols-rounded">
                    logout
                </span>
                <p>Cerrar sesión</p>
            </div>
        </div>
    </div>
    <section class="htmlcontent">
        <aside id="aside" class="aside close">
            <div class="opcion background-none display-flex row no-flex-wrap ellipsis" id="usuario_perfil"
                onclick="openMenu(event, 'infoCard')" data-ripple>
                <span class="material-symbols-rounded perfil-icon">account_circle</span>
                <div class="perfil-info ellipsis">
                    <p class="texto ellipsis">
                        <%= maestro.nombre %>
                    </p>
                    <span class="perfil-rol">
                        <%= maestro.rolNombre %>
                    </span>
                </div>
                <span class="material-symbols-rounded perfil-chevron" aria-hidden="true">expand_more</span>
            </div>
            <div class="opcion" onclick="abrirAside()" data-ripple>
                <span class="material-symbols-rounded icon" id="menu_open">
                    menu_open
                </span>
            </div>
            <a id="opcion" class="opcion" data-ripple href="/menu/inicio" data-link>
                <span class="material-symbols-rounded icon">
                    home
                </span>
                <p class="texto">Inicio</p>
            </a>
            <a class="opcion" data-ripple href="/menu/proyectos" data-link>
                <span class="material-symbols-rounded icon">
                    school
                </span>
                <p class="texto">Proyectos</p>
            </a>
            <a id="opcion" class="opcion" data-ripple href="/menu/evaluaciones" data-link>
                <span class="material-symbols-rounded icon">
                    quiz
                </span>
                <p class="texto">Evaluaciones</p>
            </a>
            <a class="opcion" data-ripple href="/menu/rubrica" data-link>
                <span class="material-symbols-rounded icon">
                    checklist
                </span>
                <p class="texto">Rubricas</p>
            </a>
            <a class="opcion" data-ripple href="/menu/papelera" data-link style="display: none;">
                <span class="material-symbols-rounded icon">
                    logo_dev
                </span>
                <p class="texto">Placeholder</p>
            </a>
        </aside>
        <div id="aside-overlay" class="mobile-only"></div>
        <main id="main__container" class="main__container">
        </main>
    </section>

    <!-- ══════════ Diálogo de Configuración ══════════ -->
    <dialog id="dialog-1" class="app-dialog--lg dialog-configuracion">
        <div class="dialog-inner">
            <!-- Cabecera: título + botón cerrar en la misma fila (la X nunca
                 solapa con las pestañas del nav) -->
            <header class="dialog-configuracion__cabecera">
                <h2 class="dialog-configuracion__titulo">Ajustes</h2>
                <button type="button" class="dialog-close-btn" id="config-btn-cerrar" aria-label="Cerrar configuración"
                    data-ripple>
                    <span class="material-symbols-rounded">close</span>
                </button>
            </header>

            <!-- Nav de pestañas -->
            <nav class="dialog-configuracion__nav" aria-label="Secciones de configuración">
                <button type="button" class="dialog-configuracion__tab active" data-tab="cuenta" data-ripple>
                    <span class="material-symbols-rounded">account_circle</span>
                    <span>Cuenta</span>
                </button>
                <button type="button" class="dialog-configuracion__tab" data-tab="informacion" data-ripple>
                    <span class="material-symbols-rounded">info</span>
                    <span>Información</span>
                </button>
            </nav>

            <!-- Contenido -->
            <div class="dialog-configuracion__contenido">

                <!-- ── Cuenta ── -->
                <section class="dialog-configuracion__panel active" data-panel="cuenta">
                    <div class="config-cuenta__cabecera">
                        <div class="config-cuenta__avatar">
                            <span class="material-symbols-rounded">account_circle</span>
                        </div>
                        <p class="config-cuenta__nombre" id="config-nombre-display">
                            <%= maestro.nombre %>
                        </p>
                    </div>

                    <div class="config-fila">
                        <span class="config-fila__label">Rol</span>
                        <span class="config-fila__valor" id="config-rol">
                            <%= maestro.rolNombre || 'Sin rol' %>
                        </span>
                    </div>

                    <div class="config-fila">
                        <span class="config-fila__label">Correo</span>
                        <span class="config-fila__valor vacio" id="config-email">Sin correo registrado</span>
                    </div>

                    <div class="config-fila config-fila--nombre">
                        <div class="config-fila__linea">
                            <span class="config-fila__label">Nombre de usuario</span>
                            <input type="text" class="config-fila__input" id="config-input-nombre"
                                value="<%= maestro.nombre %>" maxlength="255" disabled autocomplete="off"
                                aria-label="Nombre de usuario">
                            <button type="button" class="config-fila__editar" id="config-btn-editar-nombre" data-ripple>
                                <span class="material-symbols-rounded">edit</span>
                                <p>Editar</p>
                            </button>
                            <button type="button" class="config-fila__cancelar" id="config-btn-cancelar-nombre"
                                data-ripple>
                                <span class="material-symbols-rounded">close</span>
                                <p>Cancelar</p>
                            </button>
                        </div>
                    </div>

                    <button type="button" class="config-cerrar-sesion" id="config-btn-cerrar-sesion" data-ripple>
                        <span class="material-symbols-rounded">logout</span>
                        Cerrar sesión
                    </button>
                </section>

                <!-- ── Información ── -->
                <section class="dialog-configuracion__panel" data-panel="informacion">
                    <div class="config-info__logo">
                        <img src="/assets/svg/Logo_SV.svg" alt="Logo INSAL">
                        <div class="config-info__logo-texto">
                            <strong>INSAL · Evaluaciones</strong>
                            <span>Sistema de gestión y evaluación de proyectos estudiantiles</span>
                        </div>
                    </div>

                    <div class="config-info__lista">
                        <div class="config-info__fila">
                            <span><span class="material-symbols-rounded">tag</span>Versión</span>
                            <span>1.0.0</span>
                        </div>
                        <div class="config-info__fila">
                            <span><span class="material-symbols-rounded">database</span>Base de datos</span>
                            <span>PostgreSQL</span>
                        </div>
                        <div class="config-info__fila">
                            <span><span class="material-symbols-rounded">code</span>Tecnologías</span>
                            <span>Express · EJS · PWA</span>
                        </div>
                        <div class="config-info__fila">
                            <span><span class="material-symbols-rounded">school</span>Institución</span>
                            <span>INSAL</span>
                        </div>

                        <!-- Créditos: cada persona en su propia fila -->
                        <div class="config-creditos__header">
                            <span class="material-symbols-rounded">star</span>Créditos
                        </div>
                        <div class="config-info__fila">
                            <span><span class="material-symbols-rounded">person</span>José Manuel Guerra Soriano</span>
                            <span>Desarrollador</span>
                        </div>
                        <div class="config-info__fila">
                            <span><span class="material-symbols-rounded">person</span>Diego Alejandro Escobar</span>
                            <span>Contribuidor</span>
                        </div>
                        <div class="config-info__fila">
                            <span><span class="material-symbols-rounded">person</span>Jonathan Ortiz</span>
                            <span>Contribuidor</span>
                        </div>
                    </div>
                </section>

            </div>
        </div>
    </dialog>
</body>

</html>
