<!DOCTYPE html>
<html lang="es">

<head>
    <!-- Capa de red robusta: DEBE cargar primero y de forma síncrona (sin defer,
         sin type="module") para envolver window.fetch ANTES de que cualquier
         módulo del flujo lo use. Aporta timeout + reintentos + aviso
         "Reconectando…" + keep-alive frente a los cold starts de Render/Railway
         en capa gratuita. -->
    <script src="/js/fetchRobusto.js"></script>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, minimum-scale=1.0, user-scalable=no, viewport-fit=cover">
    <title>Inicia sesión</title>
    <!-- Loader de marca del flujo de evaluadores. El <style> crítico posiciona
         el overlay desde el primer pintado (antes de app-loader.css) y usa el
         mismo fondo oscuro del body para que no haya destello. -->
    <style>
        #app-loader {
            position: fixed;
            inset: 0;
            z-index: 10000;
            display: grid;
            place-items: center;
            background: #000;
        }

        #app-loader img {
            display: block;
            width: 88px;
            height: 90px;
        }
    </style>
    <link rel="stylesheet" href="/css/app-loader.css">
    <link rel="stylesheet" href="/css/notificaciones.css" />
    <link rel="stylesheet" href="/css/circular-progress.css">
    <link rel="stylesheet" href="/css/ripple.css">
    <link rel="manifest" href="/manifest.webmanifest">
    <link rel="icon" href="/assets/svg/Logo_SV.svg" type="image/svg+xml" />
    <link rel="stylesheet" href="/css/main.css">
    <link rel="stylesheet" href="/css/login.css">
    <link rel="stylesheet" href="/css/default-rules.css">
    <script type="module" src="/js/ripple.js" defer></script>
    <script type="module" src="/js/login.js" defer></script>
    <script type="module">
        import 'https://esm.run/@material/web/all.js'
    </script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=Material+Symbols+Rounded:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200&display=block" />
    <script src="/js/native-app.js" defer></script>
</head>

<body>
    <div id="app-loader" class="app-loader is-active" role="status" aria-label="Cargando">
        <img src="/assets/svg/Logo_SV_loader_blanco.svg" alt="" class="app-loader__logo">
    </div>
    <script type="module" src="/js/app-loader.js"></script>
    <script>
        // La visibilidad del loader la gestiona app-loader.js (cargado antes);
        // no usamos aquí un timeout fijo de 8000 ms que oculta el overlay a
        // medias aunque la fuente de iconos aún esté cargando.


        // ── Anti "página fantasma" al volver con la flecha ATRÁS ──────────────
        // Caso: entras al dashboard (/menu), cierras o cambias de rol, y luego
        // pulsas ATRÁS hasta esta pantalla. El navegador puede restaurarla desde
        // su back-forward cache (event.persisted=true) mostrando el login aunque
        // la sesión real ya sea otra. Forzamos una recarga para que el navegador
        // consulte al servidor (que manda no-store) y éste redirija según la
        // sesión REAL: a /menu si hay maestro, a /seleccion si hay evaluador.
        // Así nunca quedas "atorado" en un login que ya no te corresponde.
        window.addEventListener('pageshow', function (e) {
            if (e.persisted) {
                window.location.reload();
            }
        });
    </script>
    <main class="main__container">
        <section class="content">
            <div class="centrar logo_empresa">
                <img src="/assets/svg/Logo_SV.svg" class="G_logo">
                <p>INSTITUTO NACIONAL SAN LUIS</p>
            </div>
            <h1 class="title">Ingresar</h1>
            <form class="form-registrar" id="form-registrar" novalidate>
                <label for="nombre">Nombre o correo</label>
                <input placeholder="Nombre o correo" class="input__text" type="text" name="nombre" id="nombre"
                    autocomplete="username">
                <span class="error-message" id="error-nombre"></span>
                <label for="contraseña">Contraseña</label>
                <div class="password-wrapper">
                    <input placeholder="Contraseña" class="input__text" type="password" name="contraseña" id="contraseña" />
                    <button type="button" class="password-toggle" id="toggle-contraseña" aria-label="Mostrar contraseña">
                        <span class="material-symbols-rounded">visibility_off</span>
                    </button>
                </div>
                <span class="error-message" id="error-contraseña"></span>
                <button type="submit" class="centrar enviar" id="botonEnviar" data-ripple>
                    <div class="centrar gap-btn" id="mensaje1">
                        <p>Iniciando...</p>
                        <div class="boton-spinner" style="background: var(--color-primario);">
                            <svg class="svg-spinner girando" width="36" height="36" viewBox="0 0 36 36">
                                <circle class="arco-pista" cx="18" cy="18" r="13" stroke="var(--spinner-pista)" />
                                <circle class="arco-indicador indeterminado" cx="18" cy="18" r="13"
                                    stroke="var(--spinner-arco)" />
                            </svg>
                        </div>
                    </div>
                    <div class="centrar gap-btn" id="mensaje2">
                        <p>
                            Ingresar
                        </p>
                        <span class="material-symbols-rounded">
                            login
                        </span>
                    </div>
                </button>
                <div class="centrar link">
                    <p>
                        ¿Eres evaluador invitado?
                    </p>
                    <a href="/registrarse">
                        Registrarte como evaluador
                        <span class="material-symbols-rounded">
                            arrow_forward
                        </span>
                    </a>
                </div>
            </form>
        </section>
    </main>
</body>
</html>
