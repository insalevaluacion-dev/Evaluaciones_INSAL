<!DOCTYPE html>
<html lang="es">

<head>
    <!-- Capa de red robusta: DEBE cargar primero y de forma síncrona (sin defer,
         sin type="module") para envolver window.fetch ANTES de que cualquier
         módulo del flujo lo use. Aporta timeout + reintentos + aviso
         "Reconectando…" + keep-alive frente a los cold starts de Render/Railway
         en capa gratuita. -->
    <script src="/js/fetchRobusto.js"></script>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, minimum-scale=1.0, user-scalable=no, viewport-fit=cover">
    <title>Resumen de Evaluación</title>
    <!-- Loader de marca del flujo de evaluadores. El <style> crítico posiciona
         el overlay desde el primer pintado (antes de app-loader.css) con el
         fondo claro de main.css para que no haya destello. Esta vista carga
         datos por fetch, por eso el loader se retiene hasta pintarlos. -->
    <style>
        #app-loader {
            position: fixed;
            inset: 0;
            z-index: 10000;
            display: grid;
            place-items: center;
            background: #F8FAFD;
        }

        #app-loader img {
            display: block;
            width: 88px;
            height: 90px;
        }
    </style>
    <link rel="stylesheet" href="/css/app-loader.css">
    <!-- Esta vista carga datos por fetch: le pide al loader que espere la señal
         __appLoaderDataReady() (resumen.js) antes de ocultarse, para no revelar
         la página a medio pintar. Declarativo en HTML para evitar una carrera de
         timing con el arranque del módulo app-loader.js. -->
    <script>window.__appLoaderHoldData = true;</script>
    <script type="module" src="/js/app-loader.js"></script>
    <link rel="stylesheet" href="/css/main.css">
    <link rel="stylesheet" href="/css/resumen.css">
    <link rel="stylesheet" href="/css/guia.css">
    <link rel="stylesheet" href="/css/circular-progress.css">
    <link rel="stylesheet" href="/css/notificaciones.css">
    <link rel="stylesheet" href="/css/input-fields.css">
    <link rel="stylesheet" href="/css/ripple.css">
    <script type="module">
        import 'https://esm.run/@material/web/all.js'
    </script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=Material+Symbols+Rounded:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200&display=block" />
    <script src="/js/descripcion.js" defer></script>
    <script src="/js/buttonFeedback.js" defer></script>
    <script src="/js/resumen.js" defer></script>
    <script type="module" src="/js/ripple.js"></script>
    <script type="module" src="/js/notificaciones.js"></script>
    <script type="module" src="/js/guia-evaluador.js"></script>
    <link rel="icon" href="/assets/svg/Logo_SV.svg" type="image/svg+xml">
    <script src="/js/native-app.js" defer></script>
</head>

<body data-flujo="evaluador">
    <div id="app-loader" class="app-loader is-active" role="status" aria-label="Cargando">
        <img src="/assets/svg/Logo_SV_loader.svg" alt="" class="app-loader__logo">
    </div>
    <script>
        // La visibilidad del loader la gestiona app-loader.js (cargado antes);
        // no usamos aquí un timeout fijo de 8000 ms que oculta el overlay a
        // medias aunque la fuente de iconos aún esté cargando.

    </script>
    <main class="main_document">
        <div class="resumen-header">
            <span class="material-symbols-rounded resumen-header__icon">summarize</span>
            <div class="resumen-header__info">
                <span class="resumen-header__label">Evaluación</span>
                <h3 class="resumen-header__title">Resumen de Evaluación</h3>
            </div>
            <button type="button" class="guia-evaluador-btn" data-guia-evaluador data-ripple aria-label="Iniciar guía">
                <span class="material-symbols-rounded" aria-hidden="true">help</span>
                <span>Guía</span>
            </button>
        </div>
        <button type="button" class="btn centrar" id="boton-regresar" onclick="volverEvaluacion()" data-ripple data-submit>
            <div class="submit-states">
                <div class="centrar gap-btn mostrar" data-normal-content>
                    <span class="material-symbols-rounded" aria-hidden="true">arrow_back</span>
                    <span>Regresar a la pagina de evaluacion</span>
                </div>
                <div class="centrar gap-btn quitar" data-loading-content>
                    <p>Regresando...</p>
                    <div class="boton-spinner" style="background: var(--font-color-important);">
                        <svg class="svg-spinner girando" width="36" height="36" viewBox="0 0 36 36">
                            <circle class="arco-pista" cx="18" cy="18" r="13" stroke="var(--spinner-pista)" />
                            <circle class="arco-indicador indeterminado" cx="18" cy="18" r="13" stroke="var(--spinner-arco)" />
                        </svg>
                    </div>
                </div>
                <div class="centrar gap-btn quitar" data-success-content>
                    <span class="material-symbols-rounded" aria-hidden="true">check_circle</span>
                    <span>Listo</span>
                </div>
            </div>
        </button>

        <div id="resumen-criterios">
            <ul id="lista-criterios">
                <div class="centrar gap-btn gap-row" id="mensaje-cargando">
                    <p>Cargando resumen...</p>
                    <div class="boton-spinner">
                        <svg class="svg-spinner girando" width="36" height="36" viewBox="0 0 36 36">
                            <circle class="arco-pista" cx="18" cy="18" r="13" stroke="var(--spinner-pista)" />
                            <circle class="arco-indicador indeterminado" cx="18" cy="18" r="13"
                                stroke="var(--spinner-arco)" />
                        </svg>
                    </div>
                </div>
            </ul>
        </div>
        <button type="button" class="btn centrar calificar" id="boton-calificar" onclick="mostrarNotaFinal()" data-ripple data-submit>
            <div class="submit-states">
                <div class="centrar gap-btn mostrar" data-normal-content>
                    <span>Calificar</span>
                    <span class="material-symbols-rounded" aria-hidden="true">stylus_note</span>
                </div>
                <div class="centrar gap-btn quitar" data-loading-content>
                    <p>Calculando...</p>
                    <div class="boton-spinner" style="background: var(--font-color-important);">
                        <svg class="svg-spinner girando" width="36" height="36" viewBox="0 0 36 36">
                            <circle class="arco-pista" cx="18" cy="18" r="13" stroke="var(--spinner-pista)" />
                            <circle class="arco-indicador indeterminado" cx="18" cy="18" r="13" stroke="var(--spinner-arco)" />
                        </svg>
                    </div>
                </div>
                <div class="centrar gap-btn quitar" data-success-content>
                    <span class="material-symbols-rounded" aria-hidden="true">check_circle</span>
                    <span>Calculado</span>
                </div>
            </div>
        </button>

        <div id="modal-nota-final" class="modal">
            <div class="modal-content">
                <button type="button" class="modal-close" onclick="cerrarModalNotaFinal()" aria-label="Cerrar">
                    <span class="material-symbols-rounded">close</span>
                </button>
                <h2>Nota Final</h2>
                <p id="nota-final"></p>
                <button type="button" class="btn centrar calificar" id="boton-confirmar" onclick="confirmarEvaluacion()">
                    <div class="centrar gap-btn" id="mensaje1-confirmar">
                        <p>Confirmando...</p>
                        <div class="boton-spinner" style="background: var(--font-color-important);">
                            <svg class="svg-spinner girando" width="36" height="36" viewBox="0 0 36 36">
                                <circle class="arco-pista" cx="18" cy="18" r="13" stroke="var(--spinner-pista)" />
                                <circle class="arco-indicador indeterminado" cx="18" cy="18" r="13"
                                    stroke="var(--spinner-arco)" />
                            </svg>
                        </div>
                    </div>
                    <div class="centrar gap-btn" id="mensaje2-confirmar">
                        <span class="material-symbols-rounded">check_circle</span>
                        Confirmar
                    </div>
                </button>
            </div>
        </div>
    </main>
</body>

</html>
