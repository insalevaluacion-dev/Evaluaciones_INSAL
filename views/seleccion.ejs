<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, minimum-scale=1.0, user-scalable=no, viewport-fit=cover">
    <title>Selección de Proyecto</title>
    <link rel="stylesheet" href="/css/seleccion.css">
    <link rel="stylesheet" href="/css/main.css">
    <link rel="stylesheet" href="/css/selector.css">
    <link rel="stylesheet" href="/css/custom-select.css">
    <link rel="stylesheet" href="/css/circular-progress.css">
    <link rel="stylesheet" href="/css/linear-progress.css">
    <link rel="stylesheet" href="/css/notificaciones.css">
    <link rel="stylesheet" href="/css/input-fields.css">
    <link rel="stylesheet" href="/css/ripple.css">
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Rounded" rel="stylesheet" />
    <link rel="shortcut icon" href="/assets/svg/Logo_SV.svg" type="image/x-icon">
    <script src="/js/custom-select.js" defer></script>
    <script src="/js/buttonFeedback.js" defer></script>
    <script type="module" src="/js/seleccion.js"></script>
    <script type="module" src="/js/ripple.js"></script>
    <!-- type="module": el archivo usa export; como script clásico lanza
         SyntaxError y mostrarNotificacion nunca queda disponible -->
    <script type="module" src="/js/notificaciones.js"></script>
    <script src="/js/native-app.js" defer></script>
</head>

<body>
    <section class="content">
        <main class="principal">
            <form id="formulario-filtros" class="form" novalidate>
                <p class="principal__element--text">
                    <span class="material-symbols-rounded principal__element--icon">manage_search</span>
                    Busque el proyecto a evaluar:
                </p>
                <label for="tipo-evaluacion">Tipo de evaluación:</label>
                <select id="tipo-evaluacion" data-custom required>
                    <option value="" hidden>Seleccione un tipo de evaluación</option>
                    <% niveles.forEach(function (nivel) { %>
                    <option value="<%= nivel.nivel_id %>"><%= nivel.nombre %></option>
                    <% }); %>
                </select>
                <label for="año" id="label-año">Año:</label>
                <select id="año" data-custom required>
                    <option value="" hidden>Seleccione un año</option>
                </select>
                <label for="nombre">Grado:</label>
                <select id="nombre" data-custom required disabled>
                    <option value="" hidden>Seleccione un grado</option>
                </select>
                <label for="seccion">Sección:</label>
                <select id="seccion" data-custom required disabled>
                    <option value="" hidden>Seleccione una sección</option>
                </select>
                <button type="submit" id="buscar-proyectos" class="btn centrar" data-ripple data-submit disabled>
                    <div class="submit-states">
                        <div class="centrar gap-btn mostrar" data-submit-content>
                            <span class="material-symbols-rounded" aria-hidden="true">search</span>
                            <span>Buscar proyectos</span>
                        </div>
                        <div class="centrar gap-btn quitar" data-loading-content>
                            <span class="material-symbols-rounded" aria-hidden="true">hourglass_top</span>
                            <span>Buscando…</span>
                        </div>
                        <div class="centrar gap-btn quitar" data-success-content>
                            <span class="material-symbols-rounded" aria-hidden="true">check_circle</span>
                            <span>Encontrado</span>
                        </div>
                    </div>
                </button>
            </form>
        </main>

        <div id="modal-proyectos" style="display: none;" class="modal">
            <div class="modal-content">
                <div id="contenedor-proyectos"></div>
                <button onclick="cerrarModalProyectos()" id="boton-cerrar" class="btn centrar">
                    <span class="material-symbols-rounded">
                        close
                    </span>
                    Cerrar
                </button>
            </div>
        </div>
    </section>
</body>
</html>
