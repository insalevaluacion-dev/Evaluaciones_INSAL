<div class="content_inicio">
    <button type="button" class="item-boton-menu mobile-only" onclick="abrirAside()" aria-label="Abrir menú"
        data-ripple>
        <span class="material-symbols-rounded">menu</span>
    </button>
    <a href="/menu/evaluaciones" class="back-link" data-link>
        <span class="material-symbols-rounded" aria-hidden="true">arrow_back</span>
        <p>Atras</p>
    </a>
    <p class="text-title-seccion">Detalle de evaluación</p>
    <button type="button" class="btn-descargar-evaluacion" id="btn-descargar-evaluacion" aria-haspopup="dialog"
        aria-label="Descargar" data-ripple>
        <span class="material-symbols-rounded" aria-hidden="true">download</span>
        <span>Descargar</span>
    </button>
</div>
<section class="contenedor-criterios" data-proyecto-id="<%= id %>">
    <section class="container1 container1--detalle-evaluacion">
        <div class="proyecto-header">
            <span class="material-symbols-rounded proyecto-icon">school</span>
            <div class="proyecto-info">
                <span class="proyecto-label">Proyecto</span>
                <span id="nombre-proyecto">
                    <div class="proyecto-textos">
                        <p class="proyecto-titulo" id="detalle-proyecto-nombre">Cargando…</p>
                        <p class="proyecto-descripcion" id="detalle-proyecto-sub">Consultando evaluaciones…</p>
                    </div>
                </span>
            </div>
            <div id="detalle-proyecto-nota" class="detalle-proyecto__nota" hidden>
                <span class="detalle-proyecto__nota-valor">—</span>
            </div>
        </div>
    </section>
    <section class="container2">
        <p class="form-cabecera">
            <span class="material-symbols-rounded" aria-hidden="true">fact_check</span>
            <span>Evaluaciones registradas</span>
            <span id="contador-evaluaciones" class="form-cabecera__contador">0</span>
        </p>
        <div id="evaluaciones-loader" class="criterios-loader" role="status" aria-label="Cargando evaluaciones">
            <div class="progreso-lineal indeterminado">
                <div class="progreso-indicador"></div>
            </div>
        </div>
        <div id="evaluaciones-lista" class="criterios-lista"></div>
    </section>
</section>
<dialog id="dialogo-descargar-evaluacion" class="app-dialog--xs" aria-labelledby="dialogo-descargar-titulo">
    <form method="dialog" class="dialog-inner dialogo-descargar">
        <button type="button" class="dialog-close-btn" id="btn-cerrar-descargar" aria-label="Cerrar">
            <span class="material-symbols-rounded">close</span>
        </button>
        <h2 class="dialog-title" id="dialogo-descargar-titulo">
            <span class="material-symbols-rounded dialogo-editar__icono" aria-hidden="true">download</span>
            Opciones de descarga
        </h2>
        <p class="dialog-subtitle">Elige el formato para exportar las evaluaciones de este proyecto.</p>
        <div class="dialogo-descargar__opciones">
            <button type="button" class="dialogo-descargar__opcion" id="btn-descargar-excel" data-ripple>
                <span class="material-symbols-rounded" aria-hidden="true">table_view</span>
                <span class="dialogo-descargar__opcion-texto">
                    <span class="dialogo-descargar__opcion-titulo">Microsoft Excel (.xlsx)</span>
                    <small>Evaluaciones y desglose de criterios</small>
                </span>
            </button>
            <button type="button" class="dialogo-descargar__opcion" id="btn-descargar-pdf" data-ripple>
                <span class="material-symbols-rounded" aria-hidden="true">picture_as_pdf</span>
                <span class="dialogo-descargar__opcion-texto">
                    <span class="dialogo-descargar__opcion-titulo">Documento PDF (.pdf)</span>
                    <small>Reporte completo descargable</small>
                </span>
            </button>
        </div>
    </form>
</dialog>