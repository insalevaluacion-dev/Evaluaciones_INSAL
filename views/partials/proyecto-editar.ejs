<%# Proyecto: eliminar solo lo pueden Dirección y Administración %>
<% const puedeEliminarProyectos = !!(locals.permisos && locals.permisos.eliminarProyectos); %>
<div class="vista-proyecto-editar">
    <div class="content_inicio">
        <button type="button" class="item-boton-menu mobile-only" onclick="abrirAside()" aria-label="Abrir menú"
            data-ripple>
            <span class="material-symbols-rounded">menu</span>
        </button>
        <a href="/menu/proyectos" class="back-link" id="btn-atras-proyecto">
            <span class="material-symbols-rounded" aria-hidden="true">arrow_back</span>
            <p>Atras</p>
        </a>
        <p class="text-title-seccion">Editar proyecto</p>
        <span id="estado-sincronizacion" class="estado-sincronizacion estado-sincronizacion--cargando" role="status"
            aria-live="polite">
            <span class="material-symbols-rounded" aria-hidden="true">sync</span>
            <span class="estado-sincronizacion__texto">Cargando…</span>
        </span>
    </div>
    <section class="contenedor-criterios" data-proyecto-id="<%= id %>">
        <!-- Encabezado: datos actuales del proyecto -->
        <section class="container1">
            <div class="proyecto-header">
                <span class="material-symbols-rounded proyecto-icon">school</span>
                <div class="proyecto-info">
                    <span class="proyecto-label">Proyecto</span>
                    <span id="nombre-proyecto">
                        <div class="proyecto-textos">
                            <p class="proyecto-titulo" id="detalle-proyecto-nombre">Cargando…</p>
                        </div>
                    </span>
                </div>
                <p class="proyecto-descripcion" id="detalle-proyecto-sub">Consultando proyecto…</p>
            </div>
        </section>

        <!-- Pestañas: Datos del proyecto / Alumnos -->
        <form id="form-editar-proyecto" class="proyecto-editar__form" novalidate>
        <div class="proyecto-tabs">
            <div class="proyecto-tabs__bar" role="tablist" aria-label="Secciones del proyecto">
                <button type="button" role="tab" id="tab-datos" class="proyecto-tab is-activa" data-tab="datos"
                    aria-controls="panel-datos" aria-selected="true" data-ripple>
                    <span class="material-symbols-rounded" aria-hidden="true">edit</span>
                    <span class="proyecto-tab__label">Datos del proyecto</span>
                    <span class="proyecto-tab__short">Datos</span>
                </button>
                <button type="button" role="tab" id="tab-alumnos" class="proyecto-tab" data-tab="alumnos"
                    aria-controls="panel-alumnos" aria-selected="false" data-ripple>
                    <span class="material-symbols-rounded" aria-hidden="true">group</span>
                    <span>Alumnos</span>
                    <span id="contador-alumnos" class="proyecto-tab__badge">0</span>
                </button>
                <button type="button" role="tab" id="tab-actividad" class="proyecto-tab" data-tab="actividad"
                    aria-controls="panel-actividad" aria-selected="false" data-ripple>
                    <span class="material-symbols-rounded" aria-hidden="true">history</span>
                    <span>Actividad</span>
                </button>
            </div>

            <div class="proyecto-tabs__content">
                <!-- Panel: Datos del proyecto -->
                <section class="proyecto-panel is-activa" data-panel="datos" id="panel-datos" role="tabpanel"
                    aria-labelledby="tab-datos">
                    <div class="proyecto-panel__scroll">
                        <p class="form-cabecera">
                            <span class="material-symbols-rounded" aria-hidden="true">edit</span>
                            <span>Datos del proyecto</span>
                        </p>
                        <div class="field-group">
                                <label for="editar-proyecto-nombre">Nombre del proyecto <span
                                        class="requerido">*</span></label>
                                <input type="text" required autocomplete="off" placeholder="Nombre del proyecto"
                                    class="campo-nota__input" name="nombre" id="editar-proyecto-nombre" maxlength="40">
                                <span class="char-counter" data-for="editar-proyecto-nombre">0/40</span>
                            </div>
                            <div class="proyecto-editar__grid">
                                <div class="field-group">
                                    <label for="editar-proyecto-nivel">Tipo de evaluación <span
                                            class="requerido">*</span></label>
                                    <select id="editar-proyecto-nivel" name="nivel_id" class="campo-nota__input"
                                        data-custom data-searchable required>
                                        <option value="" selected disabled hidden>Cargando rúbricas…</option>
                                    </select>
                                </div>
                                <div class="field-group">
                                    <label for="editar-proyecto-materia">Materia <span
                                            class="requerido">*</span></label>
                                    <select id="editar-proyecto-materia" name="materia_id" class="campo-nota__input"
                                        data-custom data-searchable required>
                                        <option value="" selected disabled hidden>Cargando materias…</option>
                                    </select>
                                </div>
                                <div class="field-group">
                                    <label for="editar-proyecto-grado-nivel">Grado <span
                                            class="requerido">*</span></label>
                                    <select id="editar-proyecto-grado-nivel" name="grado_nivel"
                                        class="campo-nota__input" data-custom data-searchable required>
                                        <option value="" selected disabled hidden>Cargando grados…</option>
                                    </select>
                                </div>
                                <div class="field-group">
                                    <label for="editar-proyecto-grado-esp">Especialidad <span
                                            class="requerido">*</span></label>
                                    <select id="editar-proyecto-grado-esp" name="grado_esp"
                                        class="campo-nota__input" data-custom data-searchable required disabled>
                                        <option value="" selected disabled hidden>Selecciona una especialidad</option>
                                    </select>
                                </div>
                                <div class="field-group">
                                    <label for="editar-proyecto-grado">Sección <span class="requerido">*</span></label>
                                    <select id="editar-proyecto-grado" name="grado_seccion"
                                        class="campo-nota__input" data-custom data-searchable required disabled>
                                        <option value="" selected disabled hidden>Selecciona una sección</option>
                                    </select>
                                    <input type="hidden" id="editar-proyecto-grado-id" name="grado_id">
                                </div>
                            </div>
                    </div>
                </section>

                <!-- Panel: Alumnos inscritos en el proyecto -->
                <section class="proyecto-panel" data-panel="alumnos" id="panel-alumnos" role="tabpanel"
                    aria-labelledby="tab-alumnos">
                    <div class="proyecto-panel__scroll">
                        <p class="form-cabecera">
                            <span class="material-symbols-rounded" aria-hidden="true">group</span>
                            <span>Alumnos</span>
                        </p>
                        <div class="alumnos-agregar" id="alumnos-multi">
                            <button type="button" class="alumnos-multi__trigger" id="alumnos-multi-trigger"
                                aria-haspopup="listbox" aria-expanded="false" aria-controls="alumnos-multi-panel"
                                data-ripple disabled>
                                <span class="material-symbols-rounded alumnos-multi__icon" aria-hidden="true">person_add</span>
                                <span class="alumnos-multi__label" id="alumnos-multi-label">Cargando alumnos…</span>
                                <span class="alumnos-multi__badge" id="alumnos-multi-badge" hidden>0</span>
                                <span class="alumnos-multi__arrow" aria-hidden="true"></span>
                            </button>
                            <p class="alumnos-agregar__ayuda" id="alumnos-multi-ayuda">
                                Marca uno o varios alumnos del grado. Entran a la lista y se guardan con «Guardar cambios».
                            </p>
                            <div class="alumnos-multi__panel" id="alumnos-multi-panel" hidden>
                                <div class="alumnos-multi__search-wrap">
                                    <input type="search" id="alumnos-multi-buscar" class="campo-nota__input"
                                        placeholder="Buscar por nombre o NIE…" autocomplete="off"
                                        aria-label="Buscar alumnos por nombre o NIE">
                                    <button type="button" class="alumnos-multi__close" id="alumnos-multi-cerrar"
                                        aria-label="Cerrar">
                                        <span class="material-symbols-rounded" aria-hidden="true">close</span>
                                    </button>
                                </div>
                                <div class="alumnos-multi__toolbar">
                                    <button type="button" class="alumnos-multi__todos" id="alumnos-multi-todos" hidden>
                                        Quitar selección
                                    </button>
                                    <span class="alumnos-multi__resumen" id="alumnos-multi-resumen">0 seleccionados</span>
                                </div>
                                <ul class="alumnos-multi__lista" id="alumnos-multi-lista" role="listbox"
                                    aria-multiselectable="true" aria-label="Alumnos disponibles"></ul>
                                <p class="alumnos-multi__vacio" id="alumnos-multi-vacio" hidden>
                                    Ningún alumno coincide con la búsqueda.
                                </p>
                                <div class="alumnos-multi__footer">
                                    <button type="button" id="btn-agregar-alumno"
                                        class="boton-confirmar alumnos-multi__agregar" data-ripple disabled>
                                        <span class="material-symbols-rounded" aria-hidden="true">person_add</span>
                                        <span id="alumnos-multi-agregar-texto">Agregar</span>
                                    </button>
                                </div>
                            </div>
                        </div>
                        <div id="alumnos-loader" class="criterios-loader" role="status" aria-label="Cargando alumnos">
                            <div class="progreso-lineal indeterminado">
                                <div class="progreso-indicador"></div>
                            </div>
                        </div>
                        <div id="alumnos-lista" class="criterios-lista"></div>
                    </div>
                </section>

                <!-- Panel: Actividad / historial de cambios del proyecto -->
                <section class="proyecto-panel" data-panel="actividad" id="panel-actividad" role="tabpanel"
                    aria-labelledby="tab-actividad">
                    <div class="proyecto-panel__scroll">
                        <p class="form-cabecera">
                            <span class="material-symbols-rounded" aria-hidden="true">history</span>
                            <span>Historial de cambios</span>
                        </p>
                        <div id="actividad-loader" class="criterios-loader" role="status" aria-label="Cargando actividad">
                            <div class="progreso-lineal indeterminado">
                                <div class="progreso-indicador"></div>
                            </div>
                        </div>
                        <div id="actividad-lista" class="actividad-lista"></div>
                    </div>
                </section>
            </div>

            <!-- Barra de acciones universal: guardar cambios + zona de peligro -->
            <div class="proyecto-editar__acciones">
                <% if (puedeEliminarProyectos) { %>
                <div class="proyecto-editar__peligro">
                    <button type="button" id="btn-eliminar-proyecto" class="boton-eliminar-proyecto" data-ripple
                        title="Eliminar el proyecto borrará sus evaluaciones y quitará a los alumnos inscritos en él.">
                        <span class="material-symbols-rounded" aria-hidden="true">delete_forever</span>
                        <span>Eliminar proyecto</span>
                    </button>
                </div>
                <% } %>
                <button type="submit" class="boton-confirmar proyecto-editar__acciones-guardar" data-submit>
                    <div class="submit-states">
                        <!-- Estado normal -->
                        <div class="centrar gap-btn mostrar" data-submit-content>
                            <span class="material-symbols-rounded">save</span>
                            <span>Guardar cambios</span>
                        </div>
                        <!-- Estado enviando -->
                        <div class="centrar gap-btn quitar" data-loading-content>
                            <span class="material-symbols-rounded">hourglass_top</span>
                            <span>Guardando…</span>
                        </div>
                        <!-- Estado éxito -->
                        <div class="centrar gap-btn quitar" data-success-content>
                            <span class="material-symbols-rounded">check_circle</span>
                            <span>¡Hecho!</span>
                        </div>
                    </div>
                </button>
            </div>
        </div>
        </form>
    </section>
</div>

<!-- Diálogo de confirmación (reutilizado por confirmarAccion) -->
<dialog id="dialogo-confirmar" class="app-dialog--xs dialogo-confirmar" aria-labelledby="dialogo-confirmar-titulo">
    <form method="dialog" class="dialog-inner" id="dialogo-confirmar-form">
        <button type="button" class="dialog-close-btn" data-accion="cancelar" aria-label="Cancelar">
            <span class="material-symbols-rounded">close</span>
        </button>
        <span class="material-symbols-rounded dialogo-confirmar__icono" aria-hidden="true">warning</span>
        <h2 class="dialogo-confirmar-title" id="dialogo-confirmar-titulo">¿Confirmar acción?</h2>
        <p class="dialogo-confirmar-subtitle" id="dialogo-confirmar-mensaje"></p>
        <div class="dialogo-confirmar-actions">
            <button type="button" class="boton-cancelar" data-accion="cancelar" data-ripple>
                <span class="material-symbols-rounded">close</span>
                <span>Cancelar</span>
            </button>
            <button type="button" class="boton-confirmar" data-accion="confirmar" data-ripple data-submit>
                <div class="submit-states">
                    <!-- Estado normal -->
                    <div class="centrar gap-btn mostrar" data-submit-content>
                        <span class="material-symbols-rounded">check</span>
                        <span>Confirmar</span>
                    </div>
                    <!-- Estado confirmando -->
                    <div class="centrar gap-btn quitar" data-loading-content>
                        <span class="material-symbols-rounded">hourglass_top</span>
                        <span>Confirmando…</span>
                    </div>
                    <!-- Estado éxito -->
                    <div class="centrar gap-btn quitar" data-success-content>
                        <span class="material-symbols-rounded">check_circle</span>
                        <span>¡Hecho!</span>
                    </div>
                </div>
            </button>
        </div>
    </form>
</dialog>

<!-- Modal de advertencia: salir sin alumnos inscritos en el proyecto -->
<dialog id="dialogo-proyecto-sin-alumnos" class="app-dialog--xs dialogo-confirmar" aria-labelledby="dialogo-proyecto-sin-alumnos-titulo">
    <form method="dialog" class="dialog-inner" id="dialogo-proyecto-sin-alumnos-form">
        <button type="button" class="dialog-close-btn" data-accion="cancelar" aria-label="Cancelar">
            <span class="material-symbols-rounded">close</span>
        </button>
        <span class="material-symbols-rounded dialogo-confirmar__icono" aria-hidden="true">warning</span>
        <h2 class="dialogo-confirmar-title" id="dialogo-proyecto-sin-alumnos-titulo" data-dialogo-titulo>Proyecto sin alumnos</h2>
        <p class="dialogo-confirmar-subtitle" id="dialogo-proyecto-sin-alumnos-mensaje" data-dialogo-mensaje></p>
        <div class="dialogo-confirmar-actions">
            <button type="button" class="boton-cancelar" data-accion="cancelar" data-ripple>
                <span class="material-symbols-rounded">close</span>
                <span>Seguir editando</span>
            </button>
            <button type="button" class="boton-confirmar" data-accion="confirmar" data-ripple data-submit>
                <div class="submit-states">
                    <div class="centrar gap-btn mostrar" data-submit-content>
                        <span class="material-symbols-rounded">check</span>
                        <span>Salir igual</span>
                    </div>
                    <div class="centrar gap-btn quitar" data-loading-content>
                        <span class="material-symbols-rounded">hourglass_top</span>
                        <span>Saliendo…</span>
                    </div>
                    <div class="centrar gap-btn quitar" data-success-content>
                        <span class="material-symbols-rounded">check_circle</span>
                        <span>¡Hecho!</span>
                    </div>
                </div>
            </button>
        </div>
    </form>
</dialog>