<div class="title-seccion">
    <div class="title-seccion__izq">
        <button type="button" class="item-boton-menu mobile-only" onclick="abrirAside()" aria-label="Abrir menú" data-ripple>
            <span class="material-symbols-rounded">menu</span>
        </button>
        <p class="text-title-seccion">
            Evaluaciones
        </p>
    </div>
    <div class="display-flex row gap-btn ">
        <button type="button" class="centrar boton gap-btn btn-opcion" data-ripple onclick="toggleDialog('dialogo-info-evaluaciones')">
            <span class="material-symbols-rounded">info</span>
            <p>¿Cómo se calcula?</p>
        </button>
        <button type="button" class="centrar boton gap-btn btn-opcion" id="btn-descargar-grado" data-ripple aria-label="Descargar reporte por grado">
            <span class="material-symbols-rounded">download</span>
            <p>Descargar</p>
        </button>
        <button class="centrar boton btn-refresh btn-opcion" data-ripple onclick="loadProyectosEvaluados(this)">
            <span class="material-symbols-rounded btn-refresh-icon">
                refresh
            </span>
            <div class="btn-refresh-spinner">
                <div class="boton-spinner" style="background: var(--color-primario);">
                    <svg class="svg-spinner girando" width="36" height="36" viewBox="0 0 36 36">
                        <circle class="arco-pista" cx="18" cy="18" r="13" stroke="var(--spinner-pista)" />
                        <circle class="arco-indicador indeterminado" cx="18" cy="18" r="13"
                            stroke="var(--spinner-arco)" />
                    </svg>
                </div>
            </div>
        </button>
    </div>
</div>
<section id="proyectos-evaluados__container" class="list-container">
    <!-- Barra de herramientas: búsqueda + ordenar -->
    <div class="list-toolbar">
        <div class="search-wrapper" onclick="focusSearchBar(this)">
            <span class="material-symbols-rounded icon" aria-hidden="true">
                search
            </span>
            <input type="text" placeholder="Buscar proyectos evaluados..." aria-label="Buscar proyectos evaluados" role="searchbox" spellcheck="false" autocomplete="off" id="search-proyectos-evaluados" class="search-input">
            <button type="button" class="search-clear" aria-label="Limpiar búsqueda" onclick="clearSearch(this)">
                <span class="material-symbols-rounded" aria-hidden="true">close</span>
            </button>
        </div>

        <div class="toolbar-opciones">
            <label class="toolbar-control toolbar-control--filter" aria-label="Filtrar proyectos">
                <span class="material-symbols-rounded" aria-hidden="true">filter_list</span>
                <span class="toolbar-control__label">Estado:</span>
                <select id="estado-proyectos-evaluados" class="toolbar-select" data-filter data-filter-key="estado" data-custom data-dropdown-anchor=".toolbar-control--filter">
                    <option value="">Todos</option>
                    <option value="parcial">Parcial</option>
                    <option value="completa">Completa</option>
                </select>
            </label>
            <label class="toolbar-control toolbar-control--sort" aria-label="Ordenar proyectos">
                <span class="material-symbols-rounded" aria-hidden="true">swap_vert</span>
                <span class="toolbar-control__label">Ordenar por:</span>
                <select id="orden-proyectos-evaluados" class="toolbar-select" data-sort data-custom data-dropdown-anchor=".toolbar-control--sort">
                    <option value="id-desc" selected>Más recientes</option>
                    <option value="id-asc">Más antiguos</option>
                </select>
            </label>
        </div>
    </div>
    <!-- Loader: siempre visible por defecto; se oculta al cargar datos -->
    <div class="section-loader">
        <div class="progreso-lineal indeterminado">
            <div class="progreso-indicador"></div>
        </div>
    </div>
    <div class="section-empty" style="display: none;">
        <div class="empty-content">
            <span class="material-symbols-rounded empty-icon">
                school
            </span>
            <p class="empty-text">Aún no hay proyectos evaluados</p>
            <p class="empty-subtext">Los proyectos que ya fueron evaluados aparecerán aquí.</p>
        </div>
    </div>
</section>
<dialog id="dialogo-info-evaluaciones" class="app-dialog--sm" aria-labelledby="dialogo-info-evaluaciones-titulo">
    <form method="dialog" class="dialog-inner" id="dialogo-info-evaluaciones-form">
        <button type="button" class="dialog-close-btn" id="btn-cerrar-info-evaluaciones" aria-label="Cancelar">
            <span class="material-symbols-rounded">close</span>
        </button>
        <h2 class="dialog-title" id="dialogo-info-evaluaciones-titulo">
            <span class="material-symbols-rounded dialogo-editar__icono" aria-hidden="true">info</span>
            Cálculo de la nota
        </h2>
        <p class="dialog-subtitle">¿Cómo se obtiene la nota de cada proyecto?</p>
        <div class="dialog-form">
            <ul class="info-evaluaciones__lista">
                <li>La nota de cada evaluación es la suma ponderada de los criterios (puntuación × porcentaje), en escala de 0 a 10.</li>
                <li>Un proyecto se considera <strong>Completo</strong> cuando tiene 3 evaluaciones: su nota final es el promedio de esas 3.</li>
                <li>Si todavía no tiene las 3 evaluaciones, se muestra como <strong>Parcial</strong> con el promedio de las evaluaciones que ya existen.</li>
            </ul>
        </div>
        <div class="form-actions">
            <button type="button" class="boton-cancelar" id="btn-cerrar-info-evaluaciones-inferior" data-ripple>
                <span class="material-symbols-rounded">close</span>
                <span>Entendido</span>
            </button>
        </div>
    </form>
</dialog>

<!-- Diálogo: descargar reporte por grado -->
<dialog id="dialogo-descargar-grado" class="app-dialog--sm" aria-labelledby="dialogo-descargar-grado-titulo">
    <form method="dialog" class="dialog-inner" id="dialogo-descargar-grado-form" onsubmit="return false">
        <button type="button" class="dialog-close-btn" id="btn-cancelar-grado" aria-label="Cancelar">
            <span class="material-symbols-rounded">close</span>
        </button>
        <h2 class="dialog-title" id="dialogo-descargar-grado-titulo">
            <span class="material-symbols-rounded dialogo-editar__icono" aria-hidden="true">download</span>
            Descargar reporte por grado
        </h2>
        <p class="dialog-subtitle">Elige el grado y el formato. Se descarga el reporte final de todos los proyectos de ese grado.</p>
        <div class="dialog-form">
            <div class="field-group">
                <label for="grado-select-descargar">Grado</label>
                <select id="grado-select-descargar" class="grado-select-descargar" data-custom required>
                    <option value="" hidden>Selecciona un grado…</option>
                </select>
            </div>
        </div>
        <div class="form-actions">
            <button type="button" class="boton-cancelar" id="btn-cancelar-grado-inferior" data-ripple>
                <span class="material-symbols-rounded">close</span>
                <span>Cancelar</span>
            </button>
            <button type="button" class="boton-confirmar" id="btn-descargar-grado-pdf" data-ripple>
                <span class="material-symbols-rounded">picture_as_pdf</span>
                <span>PDF</span>
            </button>
            <button type="button" class="boton-confirmar" id="btn-descargar-grado-excel" data-ripple>
                <span class="material-symbols-rounded">table_view</span>
                <span>Excel</span>
            </button>
        </div>
    </form>
</dialog>